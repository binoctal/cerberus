#!/bin/sh
# Deterministic fake claude REPL for zero-LLM real-process E2E (same shim as
# the L1 integration test writeClaudeShim): the REAL bridge spawns this REAL
# process via the claude-pty path and streams its output back through both
# batching layers.
#
# Two exit semantics model a real CLI:
# - A line carrying CERBERUS_FAIL (task prompts put mission text in the
#   title/description, which precede the instruction line) means the task
#   must fail: echo it, then exit 1 two seconds later. The nonzero exit
#   rides the bridge's exit callback as a task_error report, and retry
#   exhaustion broadcasts workflow:task_failed.
# - A line carrying [QUESTION] (the buildTaskPrompt instruction every task
#   prompt ends with) means the task is done: echo it, then exit 0 two
#   seconds later — that closes the PTY session, fires the exit callback and
#   with it the completion HTTP callback (task_result ->
#   task_completed/job_status broadcasts).
# Interactive session cases never type either marker, so they keep the
# long-lived echo loop.
while IFS= read -r line; do
  printf 'FAKE_CLAUDE_ECHO: %s\n' "$line"
  case "$line" in
    *"CERBERUS_FAIL"*) sleep 5; exit 1 ;;
    *"[QUESTION]"*) sleep 5; exit 0 ;;
  esac
done
