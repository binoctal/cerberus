#!/bin/sh
# Deterministic fake claude REPL for zero-LLM real-process E2E (same shim as
# the L1 integration test writeClaudeShim): the REAL bridge spawns this REAL
# process via the claude-pty path and streams its output back through both
# batching layers.
#
# Task sessions (workflow task_assign) feed buildTaskPrompt output, whose last
# line carries the [QUESTION] instruction. A real CLI finishes the task and
# exits there, so after echoing such a line the shim exits 0 — that closes the
# PTY session, fires the bridge's exit callback and with it the completion
# HTTP callback (task_result -> task_completed/job_status broadcasts).
# Interactive session cases never type a [QUESTION] line, so they keep the
# long-lived echo loop.
while IFS= read -r line; do
  printf 'FAKE_CLAUDE_ECHO: %s\n' "$line"
  case "$line" in
    *"[QUESTION]"*) sleep 2; exit 0 ;;
  esac
done
