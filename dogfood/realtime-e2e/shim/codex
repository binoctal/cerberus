#!/bin/sh
# Deterministic codex stub for the offline dogfood env (PTY fallback path —
# the ACP/npx attempt fails first, then the bridge reconnects via PTY).
# Marker-driven, identical semantics to shim/claude, so the question
# mission works no matter which CLI the planner assigns (run 13: glm
# picked codex, whose old exit-1 stub could never ask and the task_question
# window expired):
# - CERBERUS_FAIL in the echoed task prompt → exit 1 (retry-exhaustion leg)
# - CERBERUS_ASK → print a line OPENING with [QUESTION], wait for the
#   bridge's injected answer, then exit 0 (human-in-the-loop leg)
# - otherwise the --- Instruction --- header → exit 0 (completion leg;
#   the prompt no longer spells out the literal marker — see shim/claude)
asked=0
while IFS= read -r line; do
  printf 'FAKE_codex_ECHO: %s\n' "$line"
  if [ "$asked" -eq 1 ]; then
    case "$line" in
      *"User answered your question"*) sleep 5; exit 0 ;;
    esac
    continue
  fi
  case "$line" in
    *"CERBERUS_FAIL"*) sleep 5; exit 1 ;;
    *"CERBERUS_ASK"*) printf '[QUESTION] what is the magic word?\n'; asked=1 ;;
    *"--- Instruction ---"*) sleep 5; exit 0 ;;
  esac
done
