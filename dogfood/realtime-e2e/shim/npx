#!/bin/sh
# npx router for the dogfood shim dir (prepended to the replica bridges'
# PATH): route @agentclientprotocol/claude-agent-acp invocations to the
# deterministic fake ACP agent; pass everything else through to the FIRST
# real npx found on PATH outside this shim directory (wrangler and other
# tooling must keep working).
set -u
SHIM_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ "${1:-}" = "@agentclientprotocol/claude-agent-acp" ]; then
  exec python3 "$SHIM_DIR/acp-fake-agent"
fi
OLDIFS=$IFS
IFS=:
for dir in $PATH; do
  IFS=$OLDIFS
  [ "$dir" = "$SHIM_DIR" ] && continue
  [ -x "$dir/npx" ] && exec "$dir/npx" "$@"
done
IFS=$OLDIFS
echo "shim/npx: no real npx found on PATH" >&2
exit 127
